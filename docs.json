{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BaseStonk",
  "appearance": {
    "default": "dark"
  },
  "description": "Launch a token on Base or Robinhood Chain and trade it from its first block - priced in stables, majors, tokenized stocks, or $BSTONK.",
  "colors": {
    "primary": "#0052FF",
    "light": "#00C2FF",
    "dark": "#0052FF"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/logo-light.png",
    "dark": "/logo/logo-dark.png"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "quickstart",
          "chains"
        ]
      },
      {
        "group": "Launch a token",
        "pages": [
          "launching",
          "fees",
          "dividend-baskets",
          "vesting",
          "stock-pairs",
          "managing"
        ]
      },
      {
        "group": "Trade and earn",
        "pages": [
          "trading",
          "holding",
          "bstonk",
          "referrals",
          "token-safety"
        ]
      },
      {
        "group": "Build on it",
        "pages": [
          "integration/api",
          "integration/agents",
          "integration/trading-bots",
          "integration/onchain",
          "integration/contracts"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Launch a token",
        "href": "https://basestonk.io/create"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open BaseStonk",
      "href": "https://basestonk.io"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/BaseStonk",
      "website": "https://basestonk.io"
    }
  },
  "redirects": [
    {
      "source": "/wedges",
      "destination": "/launching#the-wedges"
    },
    {
      "source": "/sell-mechanics",
      "destination": "/trading#the-sell-floor"
    },
    {
      "source": "/cto",
      "destination": "/vesting#community-takeover"
    },
    {
      "source": "/b20-mode",
      "destination": "/stock-pairs"
    }
  ]
}